# Python
__pycache__/
*.pyc

# Run-time artefacts (regenerated by WebScrape/scripts; see WebScrape/PROCESS.md §14)
WebScrape/raw/
WebScrape/logs/
WebScrape/VALIDATION.md
WebScrape/golden/recall_*.md
WebScrape/golden/misses_*.csv
WebScrape/golden/precision_sample_*.csv
*.part
WebScrape/candidates_unconfirmed_*.json
WebScrape/todo_followup_*.csv

# Secrets: never commit API keys
.openalex_key*
*.key
.env

# Enrichment: caches are re-fetched by the online steps (~1 GB); keep only the small files the offline rebuild reads
Enrichment/cache/*
!Enrichment/cache/core/
!Enrichment/cache/roster_supplement_*.json
# extra export not needed for the submission (regenerated by export_csv.py)
Enrichment/out/group3_data_all.csv
# v2 run-time artefacts (WebScrape/v2/; PROCESS.md §15)
WebScrape/v2/logs/
WebScrape/v2/VALIDATION.md
WebScrape/v2/golden/
WebScrape/v2/candidates_unconfirmed_*.json
WebScrape/v2/todo_followup_*.csv

# agent kit runtime (WebScrape/agents/)
WebScrape/agents/.runtime/
WebScrape/agents/briefs/
# v2 datasets: first-pass outputs are not committed until the final run (PROCESS.md §15)
WebScrape/v2/*.json

# Enrichment v2 run (ENRICH_*_DIR env vars, see Enrichment/scripts/oa.py)
Enrichment/cache_v2/

# explorer check screenshots (check_explorer.py)
Dashboard/site/screens/

# Analysis: pickled records (a speed-up, rebuilt on demand) and per-run temporary files
Analysis/.rec_cache/
Analysis/results_v2/paper_citation_metrics.csv
Analysis/results*/.mem

# IIIT Enrichment run: extra export, regenerated by export_csv.py
Enrichment/out_v2_iiit/group3_data_all.csv
